<Window x:Class="Jolti.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Jolti" Icon="/Jolti;component/Assets/Jolti.ico" Width="1080" Height="820" MinWidth="860" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid Background="#0F192C">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
   <TabControl.Template><ControlTemplate TargetType="TabControl">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#142039"><DockPanel LastChildFill="False">
      <StackPanel DockPanel.Dock="Top" Margin="22,32,20,32"><StackPanel Orientation="Horizontal"><Image Source="/Jolti;component/Assets/Jolti.png" Width="40" Height="40" Margin="-5,0,8,0"/><TextBlock Text="Jolti" FontSize="29" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></StackPanel><TextBlock Text="A little spark. Less typing." Foreground="#A0B2CC" FontSize="11" Margin="0,12,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="20,24"><Border Background="#1D3045" CornerRadius="10" Padding="12" Margin="0,0,0,20"><StackPanel><TextBlock Text="●  On your device" Foreground="#68D8CB" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your voice stays yours." Foreground="#A0B2CC" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="Closing this window keeps Jolti in the tray." Foreground="#A0B2CC" FontSize="11" Margin="0,0,0,12"/><Button Content="Hide to tray" Click="HideApp" ToolTip="Keep dictation running. To quit, right-click the Jolti tray icon and choose Exit." Background="#24314A" Foreground="#DDE5F4" BorderBrush="#3A4860" Margin="0"/></StackPanel>
      <StackPanel DockPanel.Dock="Top" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
     </DockPanel></Border>
     <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal" ContentSource="SelectedContent" Margin="30,28,30,8"/>
    </Grid>
   </ControlTemplate></TabControl.Template>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,2,12,0"/><TextBlock Text="Dictation"/></StackPanel></TabItem.Header>
    <ScrollViewer Foreground="{StaticResource Ink}" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="Make room for your ideas." Style="{StaticResource PageTitle}"/><TextBlock Text="Speak naturally. Jolti takes care of the typing." Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
     <Border CornerRadius="18" Padding="26" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172A45" Offset="0"/><GradientStop Color="#302454" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel>
      <TextBlock Text="THINK IT. SAY IT." Foreground="#83DDEB" FontSize="11" FontWeight="SemiBold"/>
      <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Hold to talk." Foreground="White" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Release to insert your words." Foreground="#C3CBE0" Margin="0,5,12,0"/></StackPanel><Border Grid.Column="1" CornerRadius="10" BorderBrush="#77709F" BorderThickness="1" Background="#40395F" Padding="18,12" VerticalAlignment="Center"><TextBlock Text="{Binding ActiveHotkey}" Foreground="White" FontSize="18" FontWeight="SemiBold"/></Border></Grid>
      <TextBlock Text="First, click a text field in another app. Your clipboard stays untouched." Foreground="#C3CBE0" FontSize="12" Margin="0,0,0,18"/>
      <WrapPanel><Button Content="{Binding RecordButtonText}" Command="{Binding ToggleCommand}" Style="{StaticResource Primary}"/><Button Content="Cancel transcription" Command="{Binding CancelCommand}" Visibility="{Binding IsProcessing, Converter={StaticResource VisibleWhenTrue}}"/><Button Content="Change shortcut" Click="OpenSettings" Background="Transparent" BorderBrush="#655E86" Foreground="#E4DFF7"/></WrapPanel>
      <TextBlock Text="Manual start gives you 3 seconds to switch to your destination." Foreground="#AFBDD2" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <Border Background="#3B3023" CornerRadius="10" Padding="14" Margin="0,0,0,18" Visibility="{Binding IsTestMode, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Test mode is on. Select Local Whisper in Settings to transcribe your actual voice." Foreground="#FFD68C"/></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Grid Margin="0,0,0,14"><TextBlock Text="Your latest words" Style="{StaticResource Heading}" Margin="0"/><Button Content="Copy text" Command="{Binding CopyFinalCommand}" HorizontalAlignment="Right" Padding="12,5" Margin="0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}" ToolTip="Replaces your clipboard only when you click Copy."/></Grid>
      <Grid MinHeight="85"><TextBox Text="{Binding FinalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="17" Padding="0" MaxHeight="170" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Latest dictated text"/>
       <StackPanel VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Your next thought starts here." Foreground="#A5B5CE" FontSize="16"/><TextBlock Text="After you dictate, your text will appear here for review." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
      </Grid>
      <Expander Header="View original transcript" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}"><TextBox Text="{Binding RawTranscript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="Original transcript"/></Expander>
     </StackPanel></Border>
     <TextBlock Text="LOCAL WHISPER    /    CPU ONLY    /    NO CLOUD" Foreground="#A5B5CE" FontSize="10" Margin="2,0,0,12"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,2,12,0"/><TextBlock Text="Settings"/></StackPanel></TabItem.Header>
    <DockPanel TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Your flow, your way." Style="{StaticResource PageTitle}"/><TextBlock Text="A few preferences to make Jolti feel like yours." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/></StackPanel>
     <Border DockPanel.Dock="Bottom" Background="#292B4C" CornerRadius="12" Padding="14" Margin="0,8,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SettingsNote}" Foreground="#C2BFDF" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}" Margin="0"/></Grid></Border>
     <ScrollViewer Foreground="{StaticResource Ink}" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Voice &amp; shortcut" Style="{StaticResource Heading}"/><TextBlock Text="Microphone"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Microphones}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MicrophoneId}" AutomationProperties.Name="Microphone"/><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshMicrophonesCommand}" Margin="10,6,0,16"/></Grid><TextBlock Text="Hold-to-talk shortcut"/><ComboBox ItemsSource="{Binding Hotkeys}" SelectedItem="{Binding SelectedHotkey}" AutomationProperties.Name="Hold-to-talk shortcut"/><CheckBox IsChecked="{Binding RecordingSoundEnabled}"><StackPanel><TextBlock Text="Recording sounds" FontWeight="SemiBold"/><TextBlock Text="The same little bloop when recording starts and stops." Style="{StaticResource Caption}"/></StackPanel></CheckBox><CheckBox IsChecked="{Binding MutePlaybackWhileRecording}"><StackPanel><TextBlock Text="Mute playback while recording" FontWeight="SemiBold"/><TextBlock Text="Silence the default Windows output until recording stops. The start sound will be silent." Style="{StaticResource Caption}"/></StackPanel></CheckBox><CheckBox IsChecked="{Binding CleanupEnabled}"><StackPanel><TextBlock Text="Tidy up my words" FontWeight="SemiBold"/><TextBlock Text="Clean up punctuation, capitalization, and common filler words." Style="{StaticResource Caption}"/></StackPanel></CheckBox><CheckBox IsChecked="{Binding AutoStopOnSilence}"><StackPanel><TextBlock Text="Stop automatically after silence" FontWeight="SemiBold"/><TextBlock Text="After speech begins, finish dictation after 1.5 seconds of silence." Style="{StaticResource Caption}"/></StackPanel></CheckBox><CheckBox IsChecked="{Binding SpokenCommandsEnabled}"><StackPanel><TextBlock Text="Spoken editing commands" FontWeight="SemiBold"/><TextBlock Text="Say comma, new paragraph, bullet point, numbered item, or scratch that." Style="{StaticResource Caption}"/></StackPanel></CheckBox></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Speech recognition" Style="{StaticResource Heading}"/><TextBlock Text="Runs entirely on your device. No account or upload needed." Style="{StaticResource Caption}" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding TranscriptionModes}" SelectedItem="{Binding TranscriptionMode}" AutomationProperties.Name="Transcription mode"/><TextBlock Text="Whisper model"/><ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseModel}" AutomationProperties.Name="Whisper model"/><TextBlock Text="Larger models can improve accuracy but use more memory and take longer on CPU." Style="{StaticResource Caption}" Margin="0,4,0,16"/><WrapPanel><Button Visibility="{Binding ShowDownloadButton, Converter={StaticResource VisibleWhenTrue}}" Content="Download selected model" Command="{Binding DownloadModelCommand}"/><Button Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}" Content="Cancel download" Command="{Binding CancelModelDownloadCommand}"/></WrapPanel><ProgressBar Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource Accent}" Background="#22344F" BorderThickness="0" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" Height="6" Margin="0,6"/><TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource Caption}" Margin="0,10,0,0"/><Expander Header="Model setup help" Margin="0,20,0,4"><TextBlock Text="Downloads require internet and fetch only the selected model from Hugging Face. Audio stays on your device. Models are stored in %LOCALAPPDATA%\Jolti\models and verified before use. Click Save settings after downloading. The offline install script supports Base English." Margin="0,10,0,0" Style="{StaticResource Caption}"/></Expander></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="History" Style="{StaticResource Heading}"/><CheckBox IsChecked="{Binding SaveHistory}"><StackPanel><TextBlock Text="Remember my transcripts" FontWeight="SemiBold"/><TextBlock Text="Save original and cleaned text on this device. Audio is never saved." Style="{StaticResource Caption}"/></StackPanel></CheckBox><TextBlock Text="Turning this off stops new saves. Existing entries remain until you delete them." Style="{StaticResource Caption}" Margin="0,6,0,16"/><Button Content="Delete All History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource Danger}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Margin="0,2,12,0"/><TextBlock Text="History"/></StackPanel></TabItem.Header>
    <DockPanel TextElement.Foreground="{StaticResource Ink}" TextElement.FontWeight="Normal"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Words worth keeping." Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding HistoryNote}" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/><Grid Margin="0,0,0,18"><TextBlock Text="{Binding History.Count, StringFormat='Saved transcripts · {0}'}" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Content="Delete All History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource Danger}" HorizontalAlignment="Right" Margin="0"/></Grid></StackPanel>
     <Grid><Border VerticalAlignment="Top"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Margin="0,24"><TextBlock Text="A fresh start." FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Saved transcripts will appear here when history is enabled." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,20"/><Button Content="Manage history settings" Click="OpenSettings" HorizontalAlignment="Center"/></StackPanel></Border>
      <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Date, StringFormat='{}{0:MMM d, yyyy · h:mm tt}'}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><TextBlock Text="{Binding FinalText}" FontSize="16" Margin="0,0,0,10"/><Expander Header="Original transcript"><TextBlock Text="{Binding RawTranscript}" Margin="0,10,0,10"/></Expander><WrapPanel Margin="0,14,0,0"><Button Content="Copy text" Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Delete" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Margin="0,2,12,0"/><TextBlock Text="Privacy"/></StackPanel></TabItem.Header>
    <ScrollViewer Foreground="{StaticResource Ink}" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Your voice stays yours." Style="{StaticResource PageTitle}"/><TextBlock Text="Local by design. Clear about the details." Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
     <Border Background="#153938" CornerRadius="14" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="No cloud. No account. No tracking." Foreground="#7CE1CF" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Speech recognition runs on your CPU with a verified local model. Internet is used only when you request a model download." Foreground="#B0DAD4" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Only what you choose to say" Style="{StaticResource Heading}"/><TextBlock Text="The microphone turns on only when you start a recording. The floating dot is red while recording, yellow while transcribing, and green after insertion. Recordings stop after two minutes. Audio stays in memory and is discarded after processing, even when history is enabled."/>
      <TextBlock Text="Your clipboard is yours, too" Style="{StaticResource Heading}" Margin="0,24,0,10"/><TextBlock Text="Dictation types directly into the focused app. It never reads or changes your clipboard. Only an explicit Copy button replaces clipboard contents. Windows history and cloud exclusion flags are set, but third-party clipboard tools may ignore them and other apps can read the current clipboard."/>
      <TextBlock Text="No reading over your shoulder" Style="{StaticResource Heading}" Margin="0,24,0,10"/><TextBlock Text="No screenshots, screen contents, window titles or text, typed characters, password fields, or clipboard history are read. Jolti checks only modifier-key states and the destination window handle/process ID to deliver text. It cannot detect password fields or confirm that a target accepted text, so select an ordinary text field before recording."/>
      <TextBlock Text="Your personal dictionary" Style="{StaticResource Heading}" Margin="0,24,0,10"/><TextBlock Text="Words and corrections you explicitly save stay in dictionary.json on this device. They apply before text is inserted, without uploading or training on your voice. Delete entries from Dictionary; Delete All History does not remove your dictionary."/><TextBlock Text="You control what is kept" Style="{StaticResource Heading}" Margin="0,24,0,10"/><TextBlock Text="History is off by default. If enabled, original and cleaned text are saved locally as unencrypted JSON under your Windows account. Delete All History removes these entries and the current result. It does not erase backups, clear your clipboard, remove model files, or delete words already inserted elsewhere."/>
      <Expander Header="Storage location &amp; technical details"><TextBlock Text="Settings and history remain in %LOCALAPPDATA%\Jolti for compatibility with earlier versions of Jolti. Base, Small, and Medium English models can be downloaded explicitly in Settings and are SHA-256 verified before use. Audio buffers are cleared where practical; managed memory and OS paging are not secure-erasure guarantees. Fake mode produces a test sentence without recognition." Margin="0,12,0,0"/></Expander>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" Margin="0,2,12,0"/><TextBlock Text="Dictionary"/></StackPanel></TabItem.Header>
    <ScrollViewer Foreground="{StaticResource Ink}" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Your words. Your spelling." Style="{StaticResource PageTitle}"/>
     <TextBlock Text="Teach Jolti how to write names, acronyms, and phrases you use." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Add a correction" Style="{StaticResource Heading}"/>
      <TextBlock Text="Preferred spelling"/><TextBox Text="{Binding PreferredSpelling, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,8,0,14" AutomationProperties.Name="Preferred spelling"/>
      <TextBlock Text="What Jolti hears (optional)"/><TextBox Text="{Binding HeardWord, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,8,0,10" AutomationProperties.Name="What Jolti hears"/>
      <TextBlock Text="Example: preferred spelling “Jolti”, heard as “jolty”. Leave the second box empty to fix capitalization only. Add a separate entry for each mishearing." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
      <WrapPanel><Button Content="Save word" Command="{Binding SaveWordCommand}" Style="{StaticResource Primary}"/><Button Content="New entry" Command="{Binding NewWordCommand}"/><Button Content="Delete selected" Command="{Binding DeleteWordCommand}" Style="{StaticResource Danger}"/></WrapPanel>
     </StackPanel></Border>
     <TextBlock Text="{Binding DictionaryEntries.Count, StringFormat='Saved corrections · {0}'}" Style="{StaticResource Heading}"/>
     <TextBlock Text="Select an entry to edit it. Saved changes apply immediately to future dictations." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
     <ListBox ItemsSource="{Binding DictionaryEntries}" SelectedItem="{Binding SelectedWord}" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" MaxHeight="280" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Personal dictionary">
      <ListBox.ItemTemplate><DataTemplate><Border Background="#192840" CornerRadius="12" Padding="14" Margin="0,3"><StackPanel><TextBlock Text="{Binding Spelling}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Heard, StringFormat='When Jolti hears: {0}'}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="Only exact words and phrases are corrected, ignoring letter case. This does not train the speech model. Your dictionary is stored on this device, separately from transcript history." Style="{StaticResource Caption}" Margin="0,16,0,16"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,2,12,0"/><TextBlock Text="Snippets"/></StackPanel></TabItem.Header>
    <ScrollViewer Foreground="{StaticResource Ink}" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Say less. Write more." Style="{StaticResource PageTitle}"/>
     <TextBlock Text="Turn a short phrase into a signature, link, or reusable reply." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Add or edit a snippet" Style="{StaticResource Heading}"/>
      <TextBlock Text="Phrase you will say"/><TextBox Text="{Binding SnippetTrigger, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,8,0,14" AutomationProperties.Name="Snippet trigger"/>
      <TextBlock Text="Text to insert"/><TextBox Text="{Binding SnippetText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130" Margin="0,8,0,10" AutomationProperties.Name="Snippet text"/>
      <TextBlock Text="Example: say &#x201C;my meeting link&#x201D; to insert your saved URL. Line breaks, spacing, and capitalization are kept." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
      <WrapPanel><Button Content="Save snippet" Command="{Binding SaveSnippetCommand}" Style="{StaticResource Primary}"/><Button Content="New snippet" Command="{Binding NewSnippetCommand}"/><Button Content="Delete selected" Command="{Binding DeleteSnippetCommand}" Style="{StaticResource Danger}"/></WrapPanel>
     </StackPanel></Border>
     <TextBlock Text="{Binding Snippets.Count, StringFormat='Saved snippets · {0}'}" Style="{StaticResource Heading}"/>
     <TextBlock Text="Add your first snippet above, or select a saved snippet to edit it." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
     <ListBox ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet}" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" MaxHeight="280" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved snippets">
      <ListBox.ItemTemplate><DataTemplate><Border Background="#192840" CornerRadius="12" Padding="14" Margin="0,3"><StackPanel><TextBlock Text="{Binding Trigger}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Expansion}" Style="{StaticResource Caption}" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="Triggers match whole words, ignoring letter case, after dictionary corrections. Choose distinctive phrases. Snippets stay on this device in snippets.json, separately from history. Delete All History keeps your snippets." Style="{StaticResource Caption}" Margin="0,16,0,16"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="1" Background="#152238" BorderBrush="#30425E" BorderThickness="0,1,0,0" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><Ellipse Fill="{Binding StatusColor}" Width="8" Height="8" Margin="0,0,9,0"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" MaxHeight="68" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></Grid></Border>
 </Grid>
</Window>
